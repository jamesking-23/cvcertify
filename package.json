{
  "name": "cv-certify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CV-Certify: profile-based, AI-tailored, verifiable resumes and cover letters. Static front end (GitHub Pages) + Supabase.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "sync": "node scripts/sync-function.mjs",
    "test": "node --test tests/unit.test.mjs tests/router.test.mjs tests/tiers.test.mjs tests/designs.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "model": "node scripts/download-model.js && node scripts/build-intents.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
