# Copy to .env for local development (Netlify: set these in Site settings > Environment variables)

# REQUIRED in production. Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# AI writing (resume tailoring, cover letters, interview prep, roadmaps).
# Without a key the app still works in "basic mode" with simple rule-based fallbacks.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Database. On Netlify, enabling Netlify DB sets NETLIFY_DATABASE_URL automatically.
# Without it, local dev stores data in .data/db.json (never use that in production).
NETLIFY_DATABASE_URL=

# "Continue with Google" (optional). OAuth client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Password-reset emails (optional). Without these, "Forgot password" is disabled.
RESEND_API_KEY=
MAIL_FROM=CV-Certify <no-reply@your-domain.com>

# Public site URL used in verification links and emails (no trailing slash).
SITE_URL=http://localhost:3000

# Plan changes are free self-serve until a payment provider is wired in.
# Set to "false" to lock plan changes (e.g. while integrating Stripe).
ALLOW_SELF_SERVE_PLAN_CHANGE=true
